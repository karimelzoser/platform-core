diff --git a/lib/validate-ast.js b/lib/validate-ast.js
new file mode 100644
index 0000000000000000000000000000000000000000..1c8f932e5bf243a7830cb9096aa1a4a69bfb0671
--- /dev/null
+++ b/lib/validate-ast.js
@@ -0,0 +1,20 @@
+'use strict';
+
+// Iterative validation keeps every public AST walker below a fixed recursion
+// bound, including callers that supply their own tree instead of parsing text.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const visited = new Set();
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object') throw new TypeError('Invalid brace AST node');
+    if (depth >= 128) throw new SyntaxError('Brace AST exceeds maximum depth (128)');
+    if (visited.has(node)) throw new SyntaxError('Brace AST must be an acyclic tree');
+    visited.add(node);
+    if (visited.size > 65536) throw new SyntaxError('Brace AST exceeds maximum node count');
+    if (node.nodes !== undefined) {
+      if (!Array.isArray(node.nodes)) throw new TypeError('Invalid brace AST children');
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
