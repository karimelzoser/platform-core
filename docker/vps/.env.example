# Public DNS. Create A/AAAA records for all three names before first TLS issuance.
PLATFORM_DOMAIN=app.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

# Runtime mode. Production disables all deterministic connector fixtures.
APP_ENV=production
PLATFORM_IMAGE_TAG=local

# Generated by scripts/vps/install.sh when left as CHANGE_ME.
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
PLATFORM_MIGRATOR_DB_PASSWORD=CHANGE_ME
PLATFORM_APP_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
TEMPORAL_DB_PASSWORD=CHANGE_ME
VALKEY_PASSWORD=CHANGE_ME
NATS_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Optional operational settings.
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
