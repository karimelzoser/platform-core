FROM node:24-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY patches patches
COPY apps/worker/package.json apps/worker/package.json
# The worker's durable workflow surface evolves with domain packages. Copy the
# complete package workspace before install/build so the image cannot silently
# lag behind newly declared workspace dependencies (for example Recovery).
COPY packages packages
RUN pnpm install --frozen-lockfile
COPY apps/worker apps/worker
RUN pnpm --filter @platform/worker... build

FROM node:24-bookworm-slim
WORKDIR /workspace
ENV NODE_ENV=production
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/worker/package.json ./apps/worker/package.json
COPY --from=build /workspace/apps/worker/dist ./apps/worker/dist
COPY --from=build /workspace/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=build /workspace/packages ./packages
USER node
CMD ["node", "apps/worker/dist/main.js"]
