{
  "name": "@platform/commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./order-workflows": {
      "types": "./dist/order-workflows.d.ts",
      "default": "./dist/order-workflows.js"
    },
    "./returns": {
      "types": "./dist/returns.d.ts",
      "default": "./dist/returns.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@platform/command-execution": "workspace:*",
    "@platform/database": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
