{
  "name": "platform-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present build && corepack pnpm -r --if-present typecheck",
    "lint": "corepack pnpm exec eslint .",
    "test": "corepack pnpm -r --if-present test",
    "format:check": "prettier --check .",
    "migration:verify": "tsx scripts/verify-migrations.ts",
    "preview:up": "sh scripts/preview/up.sh",
    "preview:down": "sh scripts/preview/down.sh",
    "preview:reset": "sh scripts/preview/reset.sh",
    "preview:health": "sh scripts/preview/health.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-security": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
